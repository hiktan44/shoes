# Kie.ai API key — required for /api/generate
KIE_API_KEY=

# Optional: rate-limit & upload guards
MAX_UPLOAD_BYTES=8388608
RATE_LIMIT_PER_MIN=10

# Supabase (https://supabase.com/dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# /api/analyze providers (en az birisi gerekli; her ikisi varsa OpenAI birincil, Gemini fallback)
OPENAI_API_KEY=
OPENAI_ANALYZE_MODEL=gpt-5
GEMINI_API_KEY=
GEMINI_ANALYZE_MODEL=gemini-2.5-pro
