# Kie.ai API key — required for /api/generate
KIE_API_KEY=

# Optional: rate-limit & upload guards
MAX_UPLOAD_BYTES=8388608
RATE_LIMIT_PER_MIN=10

# Supabase (https://supabase.com/dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# /api/analyze sağlayıcı zinciri — birinci öncelik OpenRouter, sonra direct OpenAI, sonra direct Gemini

# OpenRouter (önerilen — tek key ile GPT-5.5, Gemini 3.1 Pro Preview, Gemini 3.1 Flash Lite vb.)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.5
OPENROUTER_FALLBACK_MODEL=google/gemini-3.1-pro-preview
# Ücretsiz/ucuz alternatif birincil olarak kullanmak istersen:
#   OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# Kod fallback zinciri otomatik: primary → fallback → gemini-3.1-flash-lite → gemini-3.1-flash-preview → gpt-4o → gemini-2.5-pro

# Doğrudan OpenAI (OpenRouter yoksa devreye girer)
OPENAI_API_KEY=
OPENAI_ANALYZE_MODEL=gpt-4o

# Doğrudan Google (OpenRouter ve OpenAI yoksa)
GEMINI_API_KEY=
GEMINI_ANALYZE_MODEL=gemini-2.5-pro
